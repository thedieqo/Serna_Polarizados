# Plantilla de variables de entorno - SIN CREDENCIALES REALES
# T-002: Configuración inicial de base de datos PostgreSQL

# URL de conexión a PostgreSQL (Supabase u otro proveedor)
# Formato: postgresql://usuario:contrasena@host:puerto/nombre_base_datos
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/serna_polarizados

# Configuración de la aplicación
APP_NAME=Serna Polarizados API
APP_VERSION=0.1.0
DEBUG=True

# Administradores autorizados (correos verificados de Google/Supabase Auth)
ADMIN_EMAILS=correo.admin.1@example.com,correo.admin.2@example.com

# Solo True después de verificar esquema, autenticación y permisos
REGISTRO_WRITE_ENABLED=False

# Orígenes permitidos por CORS, separados por comas
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Supabase Auth - valores públicos/configuración, sin secretos
# Copiar desde Supabase Dashboard > Project Settings > API / Auth.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<valor_publico>
# Opcional; por defecto: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=
# Opcional; por defecto: ${SUPABASE_URL}/auth/v1
# SUPABASE_JWT_ISSUER=
# Audiencia esperada del access token; por defecto: authenticated
# SUPABASE_JWT_AUDIENCE=authenticated
# jwks = claves asimétricas (recomendado); auth_server = proyecto con clave JWT legacy HS256
SUPABASE_VERIFY_MODE=jwks
