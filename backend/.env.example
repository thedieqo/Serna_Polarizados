# Plantilla de variables de entorno - SIN CREDENCIALES REALES
# T-002: Configuración inicial de base de datos PostgreSQL

# URL de conexión a PostgreSQL (Supabase u otro proveedor)
# Formato: postgresql://usuario:contrasena@host:puerto/nombre_base_datos
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/serna_polarizados

# Configuración de la aplicación
APP_NAME=Serna Polarizados API
APP_VERSION=0.1.0
DEBUG=True
